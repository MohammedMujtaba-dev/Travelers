<% layout("/layouts/boilerplate")%>
<div class="updatepage">
  <div class="h1div">
    <h1>Login here !</h1>
  </div>
  <form
    style="width: 80%"
    novalidate
    class="container-sm needs-validation"
    action="/auth/login"
    method="post"
  >
    <div style="margin-bottom: 16px" class="showname">
      <label class="form-label" for="username"> Username : </label>
      <input
        type="text"
        name="username"
        placeholder="Enter your name"
        class="form-control"
        required
      />
      <div class="invalid-feedback">username should be valid</div>
    </div>
    <div style="margin-bottom: 16px">
      <label class="form-label" for="password"> Password : </label>
      <input
        type="password"
        name="password"
        placeholder="Enter a password "
        class="form-control"
        required
      />
      <div class="invalid-feedback">password should be valid</div>
    </div>

    <button type="submit">Login</button>
    <p style="text-align: center">
      Don't have an account?<a href="/auth/signup"> create one </a>
    </p>
  </form>
</div>
