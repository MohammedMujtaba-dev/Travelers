<% layout("/layouts/boilerplate")%>
<div class="updatepage">
  <div class="h1div">
    <h1>Register here !</h1>
  </div>
  <form
    style="width: 80%"
    novalidate
    class="container-sm needs-validation"
    action="/auth/signup"
    method="post"
  >
    <div style="margin-bottom: 16px">
      <label class="form-label" for="username"> Username : </label>
      <input
        type="text"
        name="username"
        placeholder="Enter a username "
        class="form-control"
        required
      />
      <div class="invalid-feedback">username should be valid</div>
    </div>
    <div style="margin-bottom: 16px">
      <label class="form-label" for="email"> Email : </label>
      <input
        type="email"
        name="email"
        placeholder="Enter a email "
        class="form-control"
        required
      />
      <div class="invalid-feedback">email should be valid</div>
    </div>
    <div style="margin-bottom: 16px">
      <label class="form-label" for="password"> Password : </label>
      <input
        type="password"
        name="password"
        placeholder="Enter a password "
        class="form-control"
        required
      />
      <div class="invalid-feedback">password should be valid</div>
    </div>
    <button type="submit">Register</button>
    <a href="/auth/login" style="text-decoration: none;text-align: center;">already have an account?</a>
    <div class="or my-5" style="display: flex; align-items: center;justify-content: center;width: 50%;margin: auto;gap: 8px;">
      <p style="border: 1px solid rgb(250, 223, 250); width: 50%"></p>
      <p style="font-family:'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;color:  rgb(169, 121, 169);">Or</p>
      <p style="border: 1px solid  rgb(250, 223, 250); width: 50%""></p>
    </div>
  </form>
</div>
